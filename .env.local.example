# Supabase (required)
# Project URL ONLY — do NOT include /rest/v1/
# Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Dashboard → Project Settings → API → anon public
# Must be a long JWT starting with eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only — never expose to the browser
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional absolute site URL (used as fallback for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maps (pick one when building search/map UI)
NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
